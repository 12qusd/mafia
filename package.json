{
  "name": "nocturne",
  "version": "0.1.0",
  "private": true,
  "description": "Project NOCTURNE — online social-deduction game (Mafia/Werewolf genre).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "sim": "pnpm --filter @nocturne/bots run sim",
    "dev:solo": "pnpm --filter @nocturne/bots run dev:solo",
    "leakcheck": "pnpm --filter @nocturne/bots run leakcheck",
    "smoke:test-mode": "node scripts/smoke-test-mode.mjs",
    "e2e": "pnpm --filter @nocturne/e2e run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
